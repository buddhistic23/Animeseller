# ---- eBay (official Browse API, https://developer.ebay.com) ----
# Create a keyset at developer.ebay.com -> "Application Keys". Production keys, not sandbox.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Set to 1 to also pull SOLD comps by scraping eBay's search page (LH_Sold=1).
# Off by default: eBay's terms prohibit scraping, use at your own discretion.
EBAY_SOLD_SCRAPE=0

# ---- Kinokuniya ----
KINO_BASE_URL=https://united-states.kinokuniya.com
# How to fetch Kinokuniya pages. auto = Chrome-impersonating HTTP first, then a real
# headless browser if that is blocked. browser = always use the headless browser
# (needs: pip install playwright && playwright install chromium).
KINO_FETCHER=auto
# Kinokuniya Privilege Card holders get 10% off most items.
KINO_MEMBER_DISCOUNT=0.10
# Sales tax you pay Kinokuniya (0.0925 = 9.25%). Set 0 if picking up tax-free / reseller cert.
KINO_SALES_TAX=0.0
# Flat shipping cost from Kinokuniya per item, if ordering online (0 if buying in store / free ship).
KINO_SHIPPING_PER_ITEM=0.0

# ---- eBay selling costs ----
# Final value fee for Books & Magazines category (13.25% as of 2025) + $0.30/order.
EBAY_FVF_RATE=0.1325
EBAY_PER_ORDER_FEE=0.30
# What it costs you to ship a book (USPS Media Mail ~ $4-6) incl. packaging.
EBAY_SHIP_COST=5.00
# Sales tax buyers pay is collected by eBay; FVF applies to it. Rough avg buyer tax rate.
BUYER_TAX_RATE=0.07

# ---- App ----
MOCK_MODE=0
DB_PATH=data/arbitrage.db
REQUEST_DELAY_SECONDS=1.5
MAX_ITEMS_PER_SCAN=60
